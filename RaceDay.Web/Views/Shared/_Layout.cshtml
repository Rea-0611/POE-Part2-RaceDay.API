<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @{
            ViewData["Title"] = "Register";
        }

        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-5">
                    <div class="card shadow">
                        <div class="card-header bg-dark text-white text-center">
                            <h4>Create a RaceDay Account</h4>
                        </div>
                        <div class="card-body">
                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger">@ViewBag.Error</div>
                            }

                            <form asp-action="Register" asp-controller="Auth" method="post">
                                <div class="mb-3">
                                    <label class="form-label">I am a...</label>
                                    <select name="role" id="roleSelect" class="form-select" onchange="toggleRoleFields()">
                                        <option value="Participant">Participant</option>
                                        <option value="Organiser">Organiser</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Full Name</label>
                                    <input type="text" name="fullName" class="form-control" required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Email</label>
                                    <input type="email" name="email" class="form-control" required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Password</label>
                                    <input type="password" name="password" class="form-control" required />
                                </div>

                                <!-- Participant Specific Fields -->
                                <div id="participantFields">
                                    <div class="mb-3">
                                        <label class="form-label">Contact Number</label>
                                        <input type="text" name="contactNumber" class="form-control" />
                                    </div>
                                </div>

                                <!-- Organiser Specific Fields -->
                                <div id="organiserFields" style="display:none;">
                                    <div class="mb-3">
                                        <label class="form-label">Organisation Name</label>
                                        <input type="text" name="organisationName" class="form-control" />
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary w-100">Register</button>
                            </form>
                            <div class="mt-3 text-center">
                                <small>Already have an account? <a asp-action="Login">Login here</a></small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <script>
                        function toggleRoleFields() {
                            var role = document.getElementById("roleSelect").value;
                            if (role === "Organiser") {
                                document.getElementById("organiserFields").style.display = "block";
                                document.getElementById("participantFields").style.display = "none";
                            } else {
                                document.getElementById("organiserFields").style.display = "none";
                                document.getElementById("participantFields").style.display = "block";
                            }
                        }
                        // Run once on page load
                        toggleRoleFields();
            </script>
        }
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RaceDay.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
