<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold text-success" asp-controller="Home" asp-action="Index">
                    🏃‍♂️ RaceDay
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Left Side of Navbar -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <!-- Organiser Links -->
                        @if (Context.Session.GetString("UserRole") == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a>
                            </li>
                        }

                       
                            <!-- Participant Links -->
                            @if (Context.Session.GetString("UserRole") == "Participant")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-controller="Participant" asp-action="MyEnrolments">My Enrolments</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-controller="Participant" asp-action="MyResults">My Results</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-controller="Participant" asp-action="Profile">Profile</a>
                                </li>
                            }
                        
                    </ul>

                    <!-- Right Side of Navbar (Auth) -->
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("JwtToken") != null)
                        {
                            <!-- Logged In View -->
                            <li class="nav-item">
                                <span class="nav-link text-white fw-bold">Hello, @Context.Session.GetString("UserName")!</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-controller="Auth" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <!-- Guest View -->
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Auth" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Auth" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted mt-5 bg-light py-3">
        <div class="container text-center">
            &copy; 2026 - RaceDay - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>