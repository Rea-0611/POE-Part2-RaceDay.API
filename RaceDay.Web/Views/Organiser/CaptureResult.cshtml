@{
    ViewData["Title"] = "Capture Result";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Capture Race Result</h4>
                </div>
                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-action="CaptureResult" method="post">
                        <input type="hidden" name="enrolmentId" value="@ViewBag.EnrolmentId" />

                        <div class="mb-3">
                            <label class="form-label">Finish Time (HH:mm:ss)</label>
                            <input type="text" name="finishTime" class="form-control" placeholder="e.g. 03:45:30" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Overall Position</label>
                            <input type="number" name="overallPosition" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Category Position</label>
                            <input type="number" name="categoryPosition" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-success w-100">Save Result</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>