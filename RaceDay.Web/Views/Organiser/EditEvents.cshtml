@model System.Text.Json.JsonElement
@{
    ViewData["Title"] = "Edit Event";
    var id = Model.GetProperty("eventId").GetInt32();
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark"><h4>Edit Event</h4></div>
        <div class="card-body">
            <form asp-action="EditEvent" method="post">
                <input type="hidden" name="id" value="@id" />
                <div class="row mb-3">
                    <div class="col-md-6"><label>Name</label><input type="text" name="eventName" value="@Model.GetProperty("eventName").GetString()" class="form-control" required /></div>
                    <div class="col-md-6"><label>Date</label><input type="datetime-local" name="eventDate" value="@Model.GetProperty("eventDate").GetDateTime().ToString("yyyy-MM-ddTHH:mm")" class="form-control" required /></div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4"><label>Location</label><input type="text" name="location" value="@Model.GetProperty("location").GetString()" class="form-control" required /></div>
                    <div class="col-md-4"><label>Distance</label><input type="text" name="distance" value="@Model.GetProperty("distance").GetString()" class="form-control" required /></div>
                    <div class="col-md-4">
                        <label>Status</label>
                        <select name="eventStatus" class="form-select">
                            <option value="Draft" selected="@(Model.GetProperty("eventStatus").GetString() == "Draft")">Draft</option>
                            <option value="Open" selected="@(Model.GetProperty("eventStatus").GetString() == "Open")">Open</option>
                            <option value="Closed" selected="@(Model.GetProperty("eventStatus").GetString() == "Closed")">Closed</option>
                            <option value="Finished" selected="@(Model.GetProperty("eventStatus").GetString() == "Finished")">Finished</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn btn-warning w-100">Save Changes</button>
            </form>
        </div>
    </div>
</div>