@model List<System.Text.Json.JsonElement>
@{
    ViewData["Title"] = "Event Enrolments";
    var eventId = ViewBag.EventId;
}

<div class="d-flex justify-content-between mt-4 mb-3">
    <h3>Enrolments</h3>
    <a asp-action="Dashboard" class="btn btn-outline-secondary">Back</a>
</div>

<table class="table table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Participant</th>
            <th>Category</th>
            <th>Payment Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var eId = item.GetProperty("enrolmentId").GetInt32();
            var pStatus = item.GetProperty("paymentStatus").GetString();
            <tr>
                <td>@item.GetProperty("participantName").GetString()</td>
                <td>@item.GetProperty("categoryName").GetString()</td>
                <td>
                    <span class="badge @(pStatus == "Paid" ? "bg-success" : "bg-warning text-dark")">@pStatus</span>
                </td>
                <td>
                    @if (pStatus == "Pending")
                    {
                        <form asp-action="MarkAsPaid" method="post" class="d-inline">
                            <input type="hidden" name="enrolmentId" value="@eId" />
                            <input type="hidden" name="eventId" value="@eventId" />
                            <button type="submit" class="btn btn-sm btn-success">Mark as Paid</button>
                        </form>
                    }
                    <a asp-action="CaptureResult" asp-route-enrolmentId="@eId" class="btn btn-sm btn-primary">Capture Result</a>
                </td>
            </tr>
        }
    </tbody>
</table>