@model List<System.Text.Json.JsonElement>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2>My Events</h2>
    <a asp-action="CreateEvent" class="btn btn-success">+ Create New Event</a>
</div>

<table class="table table-bordered shadow-sm align-middle">
    <thead class="table-dark">
        <tr>
            <th>Event Details</th>
            <th>Status</th>
            <th class="text-center">Management</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ev in Model)
        {
            var id = ev.GetProperty("eventId").GetInt32();
            var status = ev.GetProperty("eventStatus").GetString();
            <tr>
                <td>
                    <strong>@ev.GetProperty("eventName").GetString()</strong><br />
                    <small class="text-muted">@ev.GetProperty("eventDate").GetDateTime().ToShortDateString() | @ev.GetProperty("location").GetString()</small>
                </td>
                <td>
                    <span class="badge @(status == "Open" ? "bg-success" : "bg-secondary")">@status</span>
                </td>
                <td class="text-center">
                    <div class="btn-group btn-group-sm">
                        <a asp-action="ManageCategories" asp-route-eventId="@id" class="btn btn-outline-primary">Categories</a>
                        <a asp-action="EventEnrolments" asp-route-id="@id" class="btn btn-outline-info">Enrolments</a>
                        <a asp-action="EventResults" asp-route-id="@id" class="btn btn-outline-warning text-dark">Results</a>
                        <a asp-action="EditEvent" asp-route-id="@id" class="btn btn-outline-secondary">Edit</a>
                    </div>

                    <form asp-action="DeleteEvent" asp-route-id="@id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this event?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>