@model List<System.Text.Json.JsonElement>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-4 pb-3 border-bottom">
    <div>
        <h2 class="mb-0">Organiser Dashboard</h2>
        <p class="text-muted mb-0">Manage your events and participants</p>
    </div>
    <a asp-action="CreateEvent" class="btn btn-success shadow-sm">+ Create New Event</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center p-5 shadow-sm border-0">
        <h4>You don't have any events yet.</h4>
        <p>Click the button above to create your first event and start getting enrolments!</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Event Details</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    var id = ev.GetProperty("eventId").GetInt32();
                    var status = ev.GetProperty("eventStatus").GetString();
                    <tr>
                        <td>
                            <strong class="text-navy">@ev.GetProperty("eventName").GetString()</strong><br />
                            <small class="text-muted">@ev.GetProperty("distance").GetString() | @ev.GetProperty("location").GetString()</small>
                        </td>
                        <td>@ev.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge @(status == "Open" ? "bg-success" : "bg-secondary")">@status</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="ManageCategories" asp-route-eventId="@id" class="btn btn-sm btn-outline-primary" title="Categories">Categories</a>
                            <a asp-action="EventEnrolments" asp-route-id="@id" class="btn btn-sm btn-outline-info text-dark" title="Enrolments">Enrolments</a>
                            <a asp-action="EventResults" asp-route-id="@id" class="btn btn-sm btn-outline-warning text-dark" title="Results">Results</a>
                            <a asp-action="EditEvent" asp-route-id="@id" class="btn btn-sm btn-outline-secondary" title="Edit">Edit</a>
                            <form asp-action="DeleteEvent" asp-route-id="@id" method="post" class="d-inline" onsubmit="return confirm('Delete this event?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}